{
  "name": "riffle",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "0.4.0",
  "description": "A fast, local-first Markdown notes app",
  "author": "Ethan Huo <huodong.work@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "pnpm run typecheck && vite build",
    "package:dir": "pnpm run build && rm -rf release/electron && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir --publish never",
    "package:artifact": "pnpm run build && rm -rf release/electron && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "package:verify": "node scripts/verify-electron-package.mjs",
    "test:packaged": "node scripts/run-packaged-smoke.mjs",
    "test:updater": "node scripts/run-updater-smoke.mjs",
    "package:test": "pnpm run package:artifact && pnpm run package:verify && pnpm run test:packaged",
    "icons:generate": "sigil etch --output src/icons/icons.tsrx --jsx octane",
    "typecheck": "tsrx-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run test tests",
    "test:rich-text-gate": "vitest run tests/rich-text-removal.test.ts",
    "test:browser": "pnpm run build && playwright test",
    "test:electron": "pnpm run build && playwright test --config playwright.electron.config.ts"
  },
  "dependencies": {
    "@celados/fff-node": "0.10.2-nightly.dbc0f62",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@octanejs/base-ui": "^0.1.31",
    "@octanejs/cmdk": "^0.1.16",
    "@octanejs/dnd-kit": "^0.1.28",
    "@octanejs/motion": "^0.1.32",
    "@octanejs/sonner": "^0.1.28",
    "@octanejs/tanstack-query": "^0.1.32",
    "@octanejs/vite-plugin": "^0.1.33",
    "@octanejs/zustand": "^0.1.32",
    "@pierre/trees": "1.0.0-beta.6",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "comark": "^0.6.2",
    "electron-updater": "^6.8.9",
    "file-type": "^22.0.1",
    "ipaddr.js": "^2.5.0",
    "octane": "^0.1.33",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.10.0",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsrx/typescript-plugin": "^0.3.118",
    "@types/node": "^25.9.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@celados/fff-bin-darwin-arm64": "0.10.2-nightly.dbc0f62",
    "@yuuang/ffi-rs-darwin-arm64": "^1.3.7"
  }
}
